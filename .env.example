# ─── Required: LinkedIn Session Cookies ───────────────────────────────────────
LI_AT=your_li_at_cookie_here
JSESSIONID=your_jsessionid_cookie_here

# ─── Required: Internal API Security ─────────────────────────────────────────
INTERNAL_API_KEY=change_me_to_a_strong_random_secret

# ─── Required: Upstash Redis (session caching) ───────────────────────────────
UPSTASH_REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6380

# ─── Optional: Proxy Rotation ────────────────────────────────────────────────
# Format: http://user:pass@host:port  OR  socks5://user:pass@host:port
PROXY_URL=

# ─── Optional: App Tuning ────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
