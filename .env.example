# ─── LinkedIn Mobile Session Cookies (Extracted via Mobile Emulation) ───────
# Both LI_AT_COOKIE and LI_AT are supported by the application config:
LI_AT_COOKIE=your_li_at_value_here
LI_AT=your_li_at_value_here
JSESSIONID="ajax:your_jsessionid_value_here"

# ─── Optional: Internal API Security & Proxies ─────────────────────────────────
INTERNAL_API_KEY=change_me_to_a_strong_random_secret
PROXY_URL=

# ─── Optional: App Tuning ────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

